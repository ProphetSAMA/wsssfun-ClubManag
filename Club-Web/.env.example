# Backend env vars for local run. Copy to .env and fill in (".env" is gitignored).
# Generate a long random secret:
#   powershell -c "[Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))"
JWT_SECRET=
DB_USERNAME=root
DB_PASSWORD=
DB_URL=jdbc:mysql://localhost:3306/club?characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true
# Allowed frontend origins for CORS (comma separated)
CORS_ORIGINS=http://localhost:8080,http://localhost:8081
# Image upload directory
UPLOAD_PATH=D:/images/
